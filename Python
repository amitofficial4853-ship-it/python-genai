# ----------------------------
# Core Jarvis Engine
# ----------------------------
class JarvisCore:
    def __init__(self):
        self.modules = []
        self.status = "Initializing"
        self.security_layer = SecurityLayer()
        self.ai_level = "Base"  # Base -> Ultra -> SuperGod -> FullTakata

    def activate_module(self, module_name):
        module = ModuleFactory.create(module_name)
        self.modules.append(module)
        module.activate()

    def run_all(self):
        for module in self.modules:
            module.run()

